# ============================================================
# Crucix — RedLine instance (.env)   [PER USER / TENANT]
# ============================================================
# Copy to .env on each RedLine deployment and fill in the user's own keys.
# This tier runs the dashboard + trading agent and talks to the user's brokerage.
# It does NOT run the data sweep — market/OSINT intelligence arrives from the shared
# data server's database (see data-server.env.example).
#
# IMPORTANT: Do NOT put comments on the same line as a value.
# Docker env_file treats an inline comment as part of the value.

# === Dashboard server ===
PORT=3117

# === Trading agent ("Claude") ===
# DEFAULT: claude-code — runs on a Claude SUBSCRIPTION via the `claude` CLI (no API credits).
#   Requires on this host: `claude` CLI on PATH (or set CLAUDE_CLI_BIN) and `claude login`.
#   AGENT_MODEL: 'sonnet' (default, stronger reasoning) or 'haiku' (lighter quota).
AGENT_PROVIDER=claude-code
AGENT_MODEL=sonnet
# Full path to the claude binary if it's not on PATH (optional).
CLAUDE_CLI_BIN=
# ALTERNATIVE: set AGENT_PROVIDER=anthropic to use the pay-per-token API (costs credits).
# Multitenant tip: give each tenant their own key here so usage is billed per user.
ANTHROPIC_API_KEY=

# === Brokerage — SnapTrade ===
# App credentials (shared across tenants — one SnapTrade developer app per deployment):
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Per-user registration + account (the actual per-tenant secret):
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=
SNAPTRADE_ACCOUNT_ID=
SNAPTRADE_AUTH_ID=

# === Alerts — Telegram ===
# Bot via @BotFather (can be shared); chat IDs are per user (via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Dedicated channel for trade PROPOSALS (Accept/Deny cards). Falls back to TELEGRAM_CHAT_ID if unset.
PROPOSALS_CHAT_ID=

# === Alerts — Discord (optional alternative) ===
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=

# === Proposal behavior ===
# Minutes a proposal stays valid if the agent doesn't specify (expired cards auto-delete).
PROPOSAL_TTL_MINUTES=120
# Max NEW_BUY proposals surfaced per day (exits/maintenance are NOT capped; 0 = off).
MAX_PROPOSALS_PER_DAY=3

# === Stance Book (the agent's living per-stock plan) ===
STANCE_MAX_WATCH=10
STANCE_STALE_DAYS=5

# === Feedback loop (learn from resolved trades) ===
# Minimum resolved trades before the track record / calibration feed the agent.
TRACK_RECORD_MIN=3
CALIBRATION_MIN=4

# === Hard Stop-Loss (bypasses Accept/Deny — auto-sells to protect capital) ===
STOP_LOSS_INTERVAL_MS=90000
STOP_LOSS_INTRADAY=0.02
STOP_LOSS_SWING=0.05
STOP_LOSS_LONG=0.12
PROFIT_LOCK_SWING=0.03
TRAIL_SWING=0.02
INTRADAY_EOD_TIME=1545

# === Shared data source (FUTURE — not yet wired) ===
# Connection to the shared data server's database that holds the latest synthesized sweep.
# Until the split ships, a RedLine instance runs its own sweep from data-server.env.example keys.
# DATA_DB_URL=
