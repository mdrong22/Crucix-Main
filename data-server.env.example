# ============================================================
# Crucix — Data server (.env)   [ONE SHARED DEPLOYMENT]
# ============================================================
# Copy to .env on the central data server. This tier runs the ~39-source sweep +
# the ideas/thesis LLM and writes the synthesized market/OSINT intelligence to a
# database that every RedLine instance reads. Set up ONCE — this data is identical
# for all tenants, so these keys are never duplicated per user.
#
# IMPORTANT: Do NOT put comments on the same line as a value.
# Docker env_file treats an inline comment as part of the value.

# === Sweep cadence ===
REFRESH_INTERVAL_MINUTES=15
# Throttle for the forward-pacing THESIS pass (megatrend → unpriced-rung map).
THESIS_INTERVAL_MINUTES=60
# Throttle for the LLM trade-ideas pass.
IDEAS_INTERVAL_MINUTES=60
# How long congressional trade data is cached.
CONGRESS_CACHE_HOURS=24

# === LLM for the shared brief (ideas + theses) ===
# Market-wide macro brief + theses (NOT user-specific).
# Provider: anthropic | openai | gemini | openrouter | groq | ollama | ...
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Ideas/thesis fallback (OpenAI-compatible). Keep base URL pointed at Groq.
GROQ_FALLBACK_KEY=
GROQ_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
GROQ_IDEAS_MODEL=

# ============================================================
# MARKET & FINANCIAL DATA  (all free tier unless noted)
# ============================================================

# Federal Reserve Economic Data — VIX, rates, spreads (free: fredaccount.stlouisfed.org/apikeys)
FRED_API_KEY=
# Energy Information Administration — oil/gas/inventories (free: eia.gov/opendata)
EIA_API_KEY=
# Bureau of Labor Statistics — CPI/PPI/payrolls (free; keyless works at a lower limit)
BLS_API_KEY=

# Bargo — PRIMARY congressional trades + insiders (free: bargo.ai/free-apis/dash)
# Keyless = 100 rows/day; key = 250 rows / 100 req/day. Requires a visible "Data: Bargo (bargo.ai)" credit.
BARGO_API_KEY=

# Financial Modeling Prep — ONLY econ calendar + analyst upgrades now (trades moved to Bargo).
# Free tier 429s easily; candidate to move to Finnhub.
FMP_API_KEY=

# Finnhub — earnings calendar + insider buys (free: finnhub.io/register)
FINNHUB_API_KEY=
# NewsAPI.org — news / M&A headlines (free 100 req/day: newsapi.org/register)
NEWS_API_KEY=
# Benzinga — options flow / unusual activity (optional/paid; RSS-only without)
BENZINGA_API_KEY=

# Alpaca — technical setup scan / SPY reference (free paper keys work: app.alpaca.markets)
# Order execution is NOT here (that's SnapTrade on the RedLine side) — this is market data only.
ALPACA_API_KEY=
ALPACA_SECRET=

# ============================================================
# OSINT / GEOPOLITICAL
# ============================================================

# NASA FIRMS — thermal/fire detections (free: firms.modaps.eosdis.nasa.gov/api)
FIRMS_MAP_KEY=
# ACLED — conflict events (free account: acleddata.com/register; OAuth2 password grant)
ACLED_EMAIL=
ACLED_PASSWORD=
# Cloudflare Radar — internet outage/traffic anomalies (free: dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN=
# AISStream — maritime AIS tracking (free: aisstream.io)
AISSTREAM_API_KEY=
# Reddit OAuth — social velocity (free "script" app: reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# ADS-B flight tracking (optional, via RapidAPI)
ADSB_API_KEY=
RAPIDAPI_KEY=
# SEC EDGAR — no key; SEC requires a contact User-Agent. Format: "AppName contact@yourdomain.com"
SEC_USER_AGENT=
# ReliefWeb — humanitarian feed; any fair-use identifier string
RELIEFWEB_APPNAME=

# Telegram OSINT scrape — comma-separated public channels to monitor (reuses a bot token).
TELEGRAM_CHANNELS=
TELEGRAM_BOT_TOKEN=

# ============================================================
# KEYLESS SOURCES — nothing to configure
# ============================================================
# Yahoo Finance (prices/quotes/VIX/movers/metals), US Treasury, GSCPI, USAspending, UN Comtrade,
# Federal Register (policy/EOs), CHIPS Act, GDELT, OpenSky, WHO, OFAC, OpenSanctions, NOAA, EPA,
# Patents, Bluesky, KiwiSDR, CelesTrak, CISA-KEV, HackerNews, TrendForce, SEC-EDGAR filings.

# === Database output (FUTURE — not yet wired) ===
# Where the synthesized sweep is written for RedLine instances to read.
# DATA_DB_URL=
